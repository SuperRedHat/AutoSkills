{
  "model": "opus",
  "env": {
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "2"
  },
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Bash(npm publish *)",
      "mcp__claude_ai_Gmail__send_message"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "<node>",
            "args": ["<runtime>/hooks/guard.mjs", "--platform", "claude"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^mcp__project-manager__.*",
        "hooks": [
          {
            "type": "command",
            "command": "<node>",
            "args": ["<runtime>/old/hooks/guard.mjs", "--platform", "claude"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}

{
  "model": "opus",
  "env": {
    "DEMO_TELEMETRY": "0",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "6"
  },
  "subagentPromptCacheTtl": "1h",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(npm test)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Edit(<projects-posix>/demo/frozen/**)",
      "Read(<projects-posix>/demo/customer-data/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "<node>",
            "args": [
              "<runtime>/hooks/guard.mjs",
              "--platform",
              "claude"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^mcp__project-manager__.*",
        "hooks": [
          {
            "type": "command",
            "command": "<node>",
            "args": [
              "<runtime>/hooks/guard.mjs",
              "--platform",
              "claude"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "<node>",
            "args": [
              "<runtime>/hooks/session-start.mjs",
              "--platform",
              "claude"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo done"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "demo-plugin@example": true
  }
}
